{
  "schema": "design-pipeline.template-bank-template.v1",
  "id": "card.index-stats",
  "family": "card",
  "style": "index-explorer",
  "title": "Stat tiles: four white cards, each a bold label, a serif numeral, a delta with a triangle and a note, and a sparkline with a coral end dot",
  "use": "A row of headline numbers. value_1..4 and delta_1..4 are parameters; the numeral and the delta text are derived from them and the triangle follows the sign.",
  "canvas": {
    "width": 1600,
    "height": 900
  },
  "sizes": [
    "1600x900",
    "1920x1080"
  ],
  "aspect": "16:9",
  "accent": {
    "roles": [
      "coral"
    ],
    "maxShare": 0.03
  },
  "params": {
    "guides": {
      "type": "boolean",
      "default": false,
      "class": "decoration",
      "note": "draw layout guides"
    },
    "theme": {
      "type": "enum",
      "values": [
        "light",
        "dark"
      ],
      "default": "light",
      "class": "decoration",
      "note": "light (ivory #FAF9F5) or dark (#141413) ground; tile names and the tooltip keep their fixed inks"
    },
    "value_1": {
      "default": 1.26,
      "min": 0.1,
      "max": 9,
      "class": "proportion",
      "note": "tile 1's index value"
    },
    "value_2": {
      "default": 2.31,
      "min": 0.1,
      "max": 9,
      "class": "proportion",
      "note": "tile 2's index value"
    },
    "value_3": {
      "default": 0.84,
      "min": 0.1,
      "max": 9,
      "class": "proportion",
      "note": "tile 3's index value"
    },
    "value_4": {
      "default": 3.05,
      "min": 0.1,
      "max": 9,
      "class": "proportion",
      "note": "tile 4's index value"
    },
    "delta_1": {
      "default": 3.2,
      "min": -60,
      "max": 60,
      "class": "proportion",
      "note": "tile 1's change, percent (a negative one draws a coral down triangle)"
    },
    "delta_2": {
      "default": 12.8,
      "min": -60,
      "max": 60,
      "class": "proportion",
      "note": "tile 2's change, percent (a negative one draws a coral down triangle)"
    },
    "delta_3": {
      "default": -6.4,
      "min": -60,
      "max": 60,
      "class": "proportion",
      "note": "tile 3's change, percent (a negative one draws a coral down triangle)"
    },
    "delta_4": {
      "default": 1.1,
      "min": -60,
      "max": 60,
      "class": "proportion",
      "note": "tile 4's change, percent (a negative one draws a coral down triangle)"
    },
    "seed": {
      "default": 21,
      "min": 1,
      "max": 9999,
      "class": "decoration",
      "note": "seeds the sparklines"
    }
  },
  "slots": {
